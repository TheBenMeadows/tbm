  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://poap-mirror.bemeadows.workers.dev https://assets.poap.xyz https://ipfs.io https://dweb.link https://*.ipfs.dweb.link; media-src 'self' https://poap-mirror.bemeadows.workers.dev; connect-src 'self' https://api.poap.tech https://assets.poap.xyz https://poap-mirror.bemeadows.workers.dev https://ipfs.io https://dweb.link https://*.ipfs.dweb.link; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

