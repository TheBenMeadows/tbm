# The stylesheet's dist filename carries a content hash (scripts/version-css.mjs),
# so it can be cached like the font: forever, immutable. A new build names a new
# file and the pages point at it atomically — no stale-CSS window on deploy.
/output-*.css
  Cache-Control: public, max-age=31536000, immutable

/search-index.json
  Cache-Control: public, max-age=3600

/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/nostr.json
  Access-Control-Allow-Origin: *

/.well-known/lnurlp/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json

# WebFinger must be JRD and CORS-open or no fediverse client will read it; the
# file has no extension, so the content type has to be set explicitly here.
/.well-known/webfinger
  Access-Control-Allow-Origin: *
  Content-Type: application/jrd+json

# no-transform stops Cloudflare's edge rewriting the HTML. On this zone the
# JavaScript Detections beacon kept injecting into every page even with Bot
# fight mode off -- a state the Free plan exposes no control for -- which made
# the primary site fail its own manifest.json verification while every mirror
# passed. Cloudflare documents that it does not inject the script when the
# response carries Cache-Control: no-transform. The rest of the directive
# restates what Cloudflare Pages already serves for HTML, so only no-transform
# is new. Trade-off: the edge may also skip compressing these pages, which
# costs a few KB each; correctness of the published bytes wins.
# Onion-Location tells Tor Browser that an onion service carries the same page,
# so it can offer the .onion instead. Tor requires the advertising page to be
# HTTPS, which Cloudflare Pages and Netlify both are. Paths are listed one by
# one so each page points at its own onion equivalent rather than the homepage.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Onion-Location: http://meadowsvn6ah25czpa3mv735fizgdz6xp7vlzeqxpydfwnnsygtcleyd.onion/

