# Generated by scripts/build-blog.mjs from blog/posts/*.md. The markdown and the
# images under blog/media/ are the sources and are tracked; every HTML page, the
# post feed and the page list this build emits are not.
blog/index.html
blog/feed.xml
blog/pages.json
blog/*/index.html

# Worktrees and scratch state from Claude Code sessions. Each worktree is an
# embedded repo, so `git add -A` would otherwise stage a handful of bogus
# gitlink entries rather than any real content.
.claude/
