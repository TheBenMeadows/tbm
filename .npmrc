# Dependency install scripts never run for this project.
#
# btm has ignore-scripts=true in ~/.npmrc, but that does not travel: Cloudflare
# Pages and Netlify build from source in their own clouds with their own $HOME,
# so the protection stopped at the machine it was configured on. This file
# moves it into the repo, where every builder sees it.
#
# Why it matters more here than on a typical site: a postinstall hook would run
# BEFORE build-manifest.mjs hashes the output. Altered bytes would be hashed,
# signed with the release key, timestamped into Bitcoin and replicated to 27
# mirrors -- the whole provenance chain would faithfully certify them. This is
# the one gap that sits upstream of the signature rather than under it.
#
# Cost of the guard is zero: audited 2026-08-13, no package in the dependency
# tree runs an install hook (postcss-selector-parser's `prepare` does not fire
# for registry tarballs, and fsevents declares none).
ignore-scripts=true
